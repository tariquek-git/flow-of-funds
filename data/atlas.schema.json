{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fintechnorth.ca/settlement-map/atlas.schema.json",
  "title": "Settlement Map atlas",
  "type": "object",
  "required": [
    "meta",
    "groups",
    "regions",
    "parties",
    "systems",
    "scenarios",
    "sources",
    "layers",
    "currencies",
    "products",
    "access",
    "timeline"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "role": {
      "enum": [
        "messaging",
        "clearing",
        "netting",
        "settlement",
        "rulebook",
        "customer-service",
        "fx-settlement",
        "issuance",
        "reserve-management",
        "custody"
      ]
    },
    "settlementMode": {
      "enum": [
        "rtgs",
        "deferred-net",
        "real-time-funded",
        "central-bank-ledger",
        "pvp",
        "on-chain",
        "none",
        "unknown"
      ]
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "order",
        "name",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "definition": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "name",
        "currency",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,}$"
        },
        "name": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "phase": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "party": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "country",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "operator",
            "scheme-owner",
            "central-bank",
            "messaging-network",
            "participant",
            "issuer",
            "reserve-manager",
            "custodian",
            "customer"
          ]
        },
        "country": {
          "type": "string"
        },
        "generic": {
          "type": "boolean"
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs"
        },
        "logo": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id",
        "name",
        "short",
        "group",
        "region",
        "status",
        "operator",
        "scheme_owner",
        "roles",
        "settlement_asset",
        "settlement_mode",
        "settles_in",
        "settlement_timing",
        "hours",
        "participants_summary",
        "explainer",
        "caveats",
        "unknowns",
        "field_sources",
        "last_checked",
        "layer",
        "windows",
        "participants_count"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "maxLength": 14
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "region": {
          "type": "string"
        },
        "status": {
          "enum": [
            "live",
            "planned",
            "retired"
          ]
        },
        "operator": {
          "$ref": "#/$defs/id"
        },
        "scheme_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "settlement_asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "settlement_mode": {
          "$ref": "#/$defs/settlementMode"
        },
        "settles_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "settlement_timing": {
          "type": [
            "string",
            "null"
          ]
        },
        "hours": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "explainer": {
          "type": "string",
          "maxLength": 320
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_sources": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "enum": [
              "operator",
              "scheme_owner",
              "roles",
              "settlement_asset",
              "settlement_mode",
              "settles_in",
              "settlement_timing",
              "hours",
              "participants_summary",
              "explainer",
              "windows",
              "participants_count",
              "funded_by"
            ]
          },
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/sourceRefs",
              "minItems": 1
            }
          }
        },
        "last_checked": {
          "$ref": "#/$defs/date"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "participants_count": {
          "type": [
            "string",
            "null"
          ]
        },
        "access": {
          "type": "boolean"
        },
        "settles_label": {
          "type": "string",
          "maxLength": 24
        },
        "final_label": {
          "type": "string",
          "maxLength": 40
        },
        "funded_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "n",
        "from",
        "to",
        "type",
        "phase",
        "timing",
        "caption",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "via": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "message",
            "money",
            "settlement",
            "customer"
          ]
        },
        "phase": {
          "enum": [
            "authorization",
            "clearing",
            "settlement"
          ]
        },
        "timing": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "maxLength": 200
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs",
          "minItems": 1
        }
      }
    },
    "explainerLine": {
      "type": "object",
      "required": [
        "text",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs",
          "minItems": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "rail",
        "summary",
        "lanes",
        "settlement_lane",
        "steps",
        "explainer",
        "caveats",
        "last_checked"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "rail": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "settlement_lane": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "explainer": {
          "type": "object",
          "required": [
            "messaging",
            "money",
            "settlement",
            "customer"
          ],
          "additionalProperties": false,
          "properties": {
            "messaging": {
              "$ref": "#/$defs/explainerLine"
            },
            "money": {
              "$ref": "#/$defs/explainerLine"
            },
            "settlement": {
              "$ref": "#/$defs/explainerLine"
            },
            "customer": {
              "$ref": "#/$defs/explainerLine"
            }
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_checked": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "tier",
        "published",
        "accessed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "publisher": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "regulator",
            "operator",
            "analyst",
            "press"
          ]
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "days",
        "start",
        "end",
        "tz",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "enum": [
            "business",
            "daily",
            "next-business"
          ]
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "tz": {
          "enum": [
            "America/Toronto",
            "America/New_York",
            "UTC"
          ]
        },
        "kind": {
          "enum": [
            "open",
            "cutoff",
            "settlement",
            "cycle"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "name",
        "does"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "7",
            "6",
            "5",
            "4a",
            "4b",
            "3",
            "2a",
            "2b",
            "1"
          ]
        },
        "name": {
          "type": "string"
        },
        "does": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "currency": {
      "type": "object",
      "required": [
        "id",
        "flag",
        "central_bank",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "region": {
          "type": "string"
        },
        "flag": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "central_bank": {
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "type": "integer"
        },
        "how": {
          "type": "string",
          "maxLength": 320
        },
        "how_sources": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "if": {
        "properties": {
          "phase": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "region",
          "root",
          "how",
          "how_sources"
        ]
      }
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "plain",
        "region",
        "runs_on",
        "status",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 24
        },
        "plain": {
          "type": "string",
          "maxLength": 80
        },
        "region": {
          "type": "string"
        },
        "runs_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          ]
        },
        "status": {
          "enum": [
            "live",
            "planned"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs",
          "minItems": 1
        },
        "after_settlement": {
          "type": "object",
          "required": [
            "text",
            "sources"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "sources": {
              "$ref": "#/$defs/sourceRefs",
              "minItems": 1
            }
          }
        }
      }
    },
    "accessRow": {
      "type": "object",
      "required": [
        "id",
        "name",
        "party",
        "region",
        "layer",
        "uses",
        "summary",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/id"
        },
        "region": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "holds_account_at": {
          "$ref": "#/$defs/id"
        },
        "through": {
          "$ref": "#/$defs/id"
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 260
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs",
          "minItems": 1
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "date",
        "precision",
        "region",
        "status",
        "text",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "quarter",
            "year",
            "undated"
          ]
        },
        "region": {
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "done",
            "planned"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "sources": {
          "$ref": "#/$defs/sourceRefs",
          "minItems": 1
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "as_of"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "currencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/currency"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accessRow"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  }
}
