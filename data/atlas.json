  "groups": [
    {
      "id": "high-value",
      "order": 1,
      "name": "High-value and central bank settlement",
      "definition": "Systems where large or time-critical payments settle one by one, or where a central bank holds the accounts everything else settles into."
    },
    {
      "id": "batch",
      "order": 2,
      "name": "Batch clearing",
      "definition": "Systems that collect retail items through the day and settle the net amounts later."
    },
    {
      "id": "instant",
      "order": 3,
      "name": "Instant payments",
      "definition": "Systems where the customer sees the money arrive in seconds. Interbank settlement may be instant or deferred."
    },
    {
      "id": "cards",
      "order": 4,
      "name": "Card networks",
      "definition": "Networks that set card rules and route authorization and clearing between issuers and acquirers."
    },
    {
      "id": "cross-border",
      "order": 5,
      "name": "Cross-border messaging and FX settlement",
      "definition": "Networks that carry instructions between banks in different countries, or settle both legs of an FX trade together."
    },
    {
      "id": "digital",
      "order": 6,
      "name": "Stablecoins and tokenized money",
      "definition": "Digital tokens redeemable for fiat, with an issuer, a reserve manager and a custodian as separate parties."
    },
    {
      "id": "services",
      "order": 7,
      "name": "Customer-facing services",
      "definition": "Wallets, apps and super-apps that customers use. They rely on the systems above to move and settle money."
    }
  ],
