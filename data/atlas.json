  "scenarios": [
    {
      "id": "ca-us-wire",
      "title": "Canada to US business payment by wire",
      "rail": "fedwire-funds",
      "summary": "A Canadian business pays a US supplier in USD through its bank and a US correspondent.",
      "lanes": [
        "payer",
        "payer-bank",
        "swift-scrl",
        "us-correspondent",
        "payee-bank",
        "payee"
      ],
      "settlement_lane": "federal-reserve",
      "steps": [
        {
          "n": 1,
          "from": "payer",
          "to": "payer",
          "type": "customer",
          "phase": "authorization",
          "timing": "T+0",
          "caption": "The payer asks its Canadian bank to send USD to a US account.",
          "sources": [
            "bis_corr"
          ]
        },
        {
          "n": 2,
          "from": "payer-bank",
          "to": "payer-bank",
          "type": "money",
          "phase": "authorization",
          "timing": "T+0",
          "caption": "The Canadian bank debits the payer's CAD account and converts it to USD. This is a book entry at the bank, not an interbank payment.",
          "sources": [
            "bis_corr"
          ]
        },
        {
          "n": 3,
          "from": "payer-bank",
          "to": "us-correspondent",
          "via": "swift-scrl",
          "type": "message",
          "phase": "clearing",
          "timing": "T+0",
          "caption": "The Canadian bank sends a payment instruction to its US correspondent over Swift. Swift carries the message and moves no money.",
          "sources": [
            "swift_contract",
            "bis_corr"
          ]
        },
        {
          "n": 4,
          "from": "us-correspondent",
          "to": "us-correspondent",
          "type": "money",
          "phase": "clearing",
          "timing": "T+0",
          "caption": "The correspondent debits the USD account the Canadian bank holds with it.",
          "sources": [
            "bis_corr"
          ]
        },
        {
          "n": 5,
          "from": "us-correspondent",
          "to": "payee-bank",
          "via": "fedwire-funds",
          "type": "settlement",
          "phase": "settlement",
          "timing": "T+0",
          "caption": "The correspondent sends the funds over Fedwire. The credit to the payee bank's Federal Reserve master account is final.",
          "sources": [
            "frb_wires"
          ]
        },
        {
          "n": 6,
          "from": "payee-bank",
          "to": "payee",
          "type": "money",
          "phase": "settlement",
          "timing": "T+0",
          "caption": "The payee's bank credits the payee's USD account.",
          "sources": [
            "bis_corr"
          ]
        },
        {
          "n": 7,
          "from": "payee",
          "to": "payee",
          "type": "customer",
          "phase": "settlement",
          "timing": "T+0",
          "caption": "The payee sees the USD credit.",
          "sources": [
            "bis_corr"
          ]
        }
      ],
      "explainer": {
        "messaging": {
          "text": "A Swift instruction between the two banks, then a Fedwire message inside the US.",
          "sources": [
            "swift_contract",
            "frb_wires"
          ]
        },
        "money": {
          "text": "Book entries at the Canadian bank (CAD debit) and at the US correspondent (USD account debit).",
          "sources": [
            "bis_corr"
          ]
        },
        "settlement": {
          "text": "Only the US leg settles in central bank money, on Federal Reserve books through Fedwire. No CAD interbank settlement happens for this payment.",
          "sources": [
            "frb_wires",
            "bis_corr"
          ]
        },
        "customer": {
          "text": "The payer sees one outgoing wire and an FX rate. The payee sees an incoming USD credit.",
          "sources": [
            "bis_corr"
          ]
        }
      },
      "caveats": [
        "If the payee banks with the correspondent itself, step 5 becomes a book transfer and no Fedwire payment happens.",
        "The Canadian bank funds its USD account separately, through its own treasury. Interbank FX can settle in CLS, which is added in Phase 2.",
        "Timing is same day only if both banks act within Fedwire hours."
      ],
      "last_checked": "2026-10-31"
    }
  ],
