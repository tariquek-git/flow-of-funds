# FoF Native environment template
# Copy to .env.local for local development. Leave live-provider keys empty for zero-spend fixture mode.

# ── Provider selection ──────────────────────────────────────────────────────
# fixture = deterministic offline composer, no AI spend.
# openai  = OpenAI/OpenAI-compatible live provider.
# claude  = explicit Anthropic fallback.
# Unset AI_PROVIDER auto-selects OPENAI_API_KEY first, then Anthropic credentials, then fixture.
AI_PROVIDER=fixture

# OpenAI / OpenAI-compatible provider (default live path)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_LIGHT=gpt-4.1-mini
# For compatible providers only, e.g. OpenRouter/Ollama/vLLM.
OPENAI_BASE_URL=
# Only used for gpt-5 / o-series reasoning models. low|minimal|medium|high.
OPENAI_REASONING_EFFORT=low

# Optional DeepSeek fallback. Explicit opt-in: key alone is inert until AI_FALLBACK_PROVIDER=deepseek.
AI_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_LIGHT=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=low
# Observability only: DeepSeek has a balance API, but no public API for setting
# dashboard hard caps/auto-top-up. Keep provider balance at/below this cap.
DEEPSEEK_SPEND_CAP_USD=30
DEEPSEEK_LOW_BALANCE_USD=5

# Anthropic provider (only used when AI_PROVIDER=claude, or when no OPENAI_API_KEY exists)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-opus-4-8
AI_MODEL_LIGHT=claude-haiku-4-5

# ── Access / admin ──────────────────────────────────────────────────────────
# Public mode opens the app shell; paid /api/agent is still protected by origin/rate/budget layers.
FOF_PUBLIC=0
# Shared passphrase for gated preview mode. Required for keyed Vercel deploys unless public mode is intentional.
FOF_GATE_SECRET=
# Separate admin passphrase/cookie secret for /admin.
FOF_ADMIN_SECRET=
# Vercel Cron bearer secret for /api/cron/daily-audit. The public health route
# exposes only whether this is present, never the value.
CRON_SECRET=

# Vercel automatically supplies VERCEL_GIT_COMMIT_SHA on Git deployments.
# Release operators may pass the same non-secret identity as FOF_BUILD_SHA for
# an unaliased CLI candidate; do not store it as a project-level env var.
FOF_BUILD_SHA=

# Emergency kill switch for live AI generation. Unset/1 = live; 0 = /api/agent
# refuses with a friendly 503 before any token spend. Curated templates, saved
# flows, Story/System, exports, and sharing keep working while paused.
FOF_AI_GENERATION_ENABLED=1

# ── Spend / rate-limit backing store ────────────────────────────────────────
FOF_DAILY_USD_CAP=25
# Optional override. Leave unset/blank: Vercel live-key deploys require a shared store by default; local fixture/dev does not.
# Set 0 only for a deliberate temporary prod bypass.
FOF_REQUIRE_SHARED_CAP=

# Supabase-backed rate limit, spend cap, and beta conversation logging.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_KEY=

# Upstash/Vercel KV fallback for distributed rate limits/spend cap.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Bot / analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Smoke-test helpers ──────────────────────────────────────────────────────
FOF_SMOKE_URL=
FOF_SMOKE_SERVE=0
# Optional remote-release assertions. The SHA is non-secret. Set REQUIRE_LIVE
# only for a production-configured, unaliased candidate or production itself.
FOF_SMOKE_EXPECT_SHA=
FOF_SMOKE_REQUIRE_LIVE=0
PORT=3000
