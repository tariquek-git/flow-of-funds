{
  "note": "Single source for colour and line tokens. prototype/canada/index.html must contain every value here; npm run check fails if they drift.",
  "themes": {
    "light": {
      "paper": "#F3F3EF",
      "ink": "#1B1B1B",
      "muted": "#5A564F",
      "rule": "#D3CCC0",
      "rule-strong": "#8A8378",
      "accent": "#8C1D3A",
      "accent-soft": "#EFE2E4",
      "planned": "#6A5418"
    },
    "dark": {
      "paper": "#16171A",
      "ink": "#ECE8E1",
      "muted": "#A9A398",
      "rule": "#34363B",
      "rule-strong": "#7D7A74",
      "accent": "#EE9AAE",
      "accent-soft": "#2C1E22",
      "planned": "#D9B865"
    }
  },
  "lines": {
    "message": {
      "width": "1px",
      "dash": "4 3",
      "head": "open",
      "color": "ink"
    },
    "money": {
      "width": "2.5px",
      "dash": "none",
      "head": "filled",
      "color": "ink"
    },
    "settlement": {
      "width": "2.5px",
      "dash": "none",
      "double": true,
      "head": "bar",
      "color": "accent",
      "label": "final"
    },
    "customer": {
      "width": "0",
      "label": "plain text in the lane, no line"
    }
  },
  "contrast_pairs": [
    {
      "fg": "ink",
      "bg": "paper",
      "min": 4.5,
      "use": "body text"
    },
    {
      "fg": "muted",
      "bg": "paper",
      "min": 4.5,
      "use": "secondary text, captions, source lines"
    },
    {
      "fg": "accent",
      "bg": "paper",
      "min": 4.5,
      "use": "settlement labels and links"
    },
    {
      "fg": "planned",
      "bg": "paper",
      "min": 4.5,
      "use": "planned status label"
    },
    {
      "fg": "ink",
      "bg": "accent-soft",
      "min": 4.5,
      "use": "text on selected row"
    },
    {
      "fg": "accent",
      "bg": "accent-soft",
      "min": 4.5,
      "use": "accent text on selected row"
    },
    {
      "fg": "rule-strong",
      "bg": "paper",
      "min": 3.0,
      "use": "table rules, sheet handle, unselected control borders"
    },
    {
      "fg": "accent",
      "bg": "paper",
      "min": 3.0,
      "use": "focus ring and settlement double line"
    },
    {
      "fg": "ink",
      "bg": "paper",
      "min": 3.0,
      "use": "message and money lines"
    }
  ]
}
