{
  "note": "Single source for colour and line tokens. prototype/canada/index.html must contain every value here; npm run check fails if they drift. Colour encodes role only: accent = central bank money and finality. Everything else is ink.",
  "themes": {
    "light": {
      "paper": "#FFFFFF",
      "band": "#F1F3F5",
      "ink": "#0D1117",
      "muted": "#4B5361",
      "rule": "#DDE1E6",
      "rule-strong": "#767F8C",
      "accent": "#B9301A",
      "accent-soft": "#FCECE8",
      "planned": "#7A5600"
    },
    "dark": {
      "paper": "#0E1013",
      "band": "#171A1F",
      "ink": "#E9EBEE",
      "muted": "#A4ABB6",
      "rule": "#2B3038",
      "rule-strong": "#737C88",
      "accent": "#FF826A",
      "accent-soft": "#2B1813",
      "planned": "#E2B94F"
    }
  },
  "lines": {
    "message": {
      "width": "1px",
      "dash": "4 3",
      "head": "open",
      "color": "ink"
    },
    "money": {
      "width": "2.5px",
      "dash": "none",
      "head": "filled",
      "color": "ink"
    },
    "settlement": {
      "width": "2.5px",
      "dash": "none",
      "double": true,
      "head": "bar",
      "color": "accent",
      "label": "final"
    },
    "customer": {
      "width": "0",
      "label": "plain text in the lane, no line"
    }
  },
  "contrast_pairs": [
    {
      "fg": "ink",
      "bg": "paper",
      "min": 4.5,
      "use": "body text"
    },
    {
      "fg": "ink",
      "bg": "band",
      "min": 4.5,
      "use": "text on layer band"
    },
    {
      "fg": "muted",
      "bg": "paper",
      "min": 4.5,
      "use": "secondary text, captions, source lines"
    },
    {
      "fg": "muted",
      "bg": "band",
      "min": 4.5,
      "use": "secondary text on layer band"
    },
    {
      "fg": "accent",
      "bg": "paper",
      "min": 4.5,
      "use": "settlement labels, timing on settles-in lines"
    },
    {
      "fg": "accent",
      "bg": "band",
      "min": 4.5,
      "use": "settlement labels on layer band"
    },
    {
      "fg": "planned",
      "bg": "band",
      "min": 4.5,
      "use": "planned label on layer band"
    },
    {
      "fg": "planned",
      "bg": "paper",
      "min": 4.5,
      "use": "planned label"
    },
    {
      "fg": "ink",
      "bg": "accent-soft",
      "min": 4.5,
      "use": "text on central bank base"
    },
    {
      "fg": "accent",
      "bg": "accent-soft",
      "min": 4.5,
      "use": "accent text on central bank base"
    },
    {
      "fg": "rule-strong",
      "bg": "paper",
      "min": 3.0,
      "use": "node outlines, control borders, clock gridlines"
    },
    {
      "fg": "rule-strong",
      "bg": "band",
      "min": 3.0,
      "use": "node outlines on layer band"
    },
    {
      "fg": "accent",
      "bg": "band",
      "min": 3.0,
      "use": "settles-in double line on band, focus ring"
    },
    {
      "fg": "ink",
      "bg": "band",
      "min": 3.0,
      "use": "runs-on lines"
    }
  ]
}
