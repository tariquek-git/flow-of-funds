{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/agent/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-audit",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "flow.fintechnorth.ca" }],
      "destination": "https://flows.fintechnorth.ca/:path*",
      "permanent": true
    }
  ]
}
